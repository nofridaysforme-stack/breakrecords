# Indie SRVCS environment. Copy to apps/web/.env.local for local live mode.
# Secrets go only in Vercel and Supabase settings, never in the repo.

# Postgres. The app connects as br_app (owns nothing, so row-level security always applies).
DATABASE_URL=postgres://br_app:br_app_local@localhost:5432/breakrecords_dev
# Migrations and seeding run as the owner role.
MIGRATION_DATABASE_URL=postgres://br_owner:br_owner_local@localhost:5432/breakrecords_dev?sslmode=disable

# Sign-in (Auth.js magic links). Required whenever any module is live.
BR_AUTH=required
AUTH_SECRET=generate-with-openssl-rand-base64-32
APP_URL=http://localhost:3000
# Local and tests: sign-in links are written here instead of emailed.
AUTH_TEST_MAILBOX=./test-results/mailbox
# Staging and production: Resend.
RESEND_API_KEY=
EMAIL_FROM="Indie SRVCS <no-reply@your-domain>"

# Modules on the live backend; everything else stays on the mock. Production flips one per gate.
BR_LIVE_MODULES=approvals,catalog,contracts,roster,splits,statements,payouts,registrations,releases,funding,activity,settings

# Prepared documents: a local folder by default (.data/documents). Staging and production use
# Supabase Storage: DOCUMENTS_S3_ENDPOINT, DOCUMENTS_S3_REGION, DOCUMENTS_S3_BUCKET,
# DOCUMENTS_S3_ACCESS_KEY_ID, DOCUMENTS_S3_SECRET_ACCESS_KEY (docs/STAGING.md, step 8).
# DOCUMENTS_DIR=
# AI review of documents: off unless BR_AI=on and a key is set (and the label's owner turns it on).
# BR_AI=on
# ANTHROPIC_API_KEY=
