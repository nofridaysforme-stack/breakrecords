{
  "name": "breakrecords-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @breakrecords/web dev",
    "build": "pnpm --filter @breakrecords/web build",
    "start": "pnpm --filter @breakrecords/web start",
    "lint": "pnpm -r --if-present typecheck && node apps/web/scripts/lint-copy.mjs",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @breakrecords/web test:e2e"
  }
}
